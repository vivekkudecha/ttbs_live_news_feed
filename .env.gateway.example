# Gateway settings - copy to .env.<env>.gateway (dev / uat / prod; never commit it).
# Only this file reaches the internet-facing gateway container: no application secrets here.

# Password gate in front of /phpmyadmin/ (dev / uat only). One "user:bcrypt-hash" line; generate:
#   printf '%s' 'YOUR-STRONG-PASSWORD' | podman run --rm -i docker.io/library/phpmyadmin:5.2.3 htpasswd -niB -C 12 dbadmin
# Keep the single quotes (the hash contains $). Empty or unset = the gate refuses everyone.
GATEWAY_PMA_HTPASSWD=''
