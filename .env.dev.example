# DEV environment - used by docker-compose.dev.yml (copy to .env.dev; never commit .env.dev).
# ENV accepts only dev | test | prod.
ENV=dev
LOG_LEVEL=INFO

# --- MySQL container (created on first start) ---
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=ttbs_newsfeed
MYSQL_USER=ttbs
MYSQL_PASSWORD=change_me_ttbs
# Must match the values above. Host "mysql" = the container on the compose network.
# Avoid @ : / ? # % in the password (or URL-encode them).
DATABASE_URL=mysql+pymysql://ttbs:change_me_ttbs@mysql:3306/ttbs_newsfeed?charset=utf8mb4

# --- Redis container (internal network only) ---
# Redis requires this password (letters and digits only, so it is URL-safe below).
REDIS_PASSWORD=CHANGE_ME_redis
BROKER_URL=redis://:CHANGE_ME_redis@redis:6379/5
REDIS_CACHE_URL=redis://:CHANGE_ME_redis@redis:6379/6

# --- Required: 32 random bytes, url-safe base64 (encrypts LLM API keys in the DB) ---
# python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SECRETS_KEY=

# "perplexity" = live API (key set in the UI); "fake" = offline, no key or cost.
LLM_PROVIDER=perplexity

NOTIFY_EMAIL_ADAPTER=console
NOTIFY_WHATSAPP_ADAPTER=console
MONTHLY_BUDGET_USD=50

# --- Sign-in & sessions (docs/security.md) ---
# First admin: created at startup only while no user exists, and forced to change this password
# at first sign-in. It must meet the policy (12+ chars, upper, lower, digit, symbol, no common
# words, no username). Remove it from this file once the admin has signed in.
ADMIN_USERNAME=admin
ADMIN_NAME=Administrator
ADMIN_INITIAL_PASSWORD=
# Session cookie is Secure (HTTPS only; browsers also accept it on http://localhost / 127.0.0.1).
SESSION_COOKIE_SECURE=true
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12
PASSWORD_HISTORY_COUNT=5
PASSWORD_MAX_AGE_DAYS=90
# SPA and API share one origin behind the gateway: no cross-origin access is needed.
CORS_ORIGINS=[]
