# DEV environment - used by docker-compose.dev.yml (copy to .env.dev; never commit .env.dev).
# ENV accepts only dev | test | prod.
ENV=dev
LOG_LEVEL=INFO

# --- MySQL container (created on first start) ---
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=ttbs_newsfeed
MYSQL_USER=ttbs
MYSQL_PASSWORD=change_me_ttbs
# Must match the values above. Host "mysql" = the container on the compose network.
# Avoid @ : / ? # % in the password (or URL-encode them).
DATABASE_URL=mysql+pymysql://ttbs:change_me_ttbs@mysql:3306/ttbs_newsfeed?charset=utf8mb4

# --- Redis container ---
BROKER_URL=redis://redis:6379/5
REDIS_CACHE_URL=redis://redis:6379/6

# --- Required: 32 random bytes, url-safe base64 (encrypts LLM API keys in the DB) ---
# python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SECRETS_KEY=

# "perplexity" = live API (key set in the UI); "fake" = offline, no key or cost.
LLM_PROVIDER=perplexity

NOTIFY_EMAIL_ADAPTER=console
NOTIFY_WHATSAPP_ADAPTER=console
MONTHLY_BUDGET_USD=50
