# Copy to backend/.env and fill in. Never commit .env.
ENV=dev
LOG_LEVEL=INFO

# Postgres: create the role/database once with scripts/create_db.sql
DATABASE_URL=postgresql+psycopg://ttbs:CHANGE_ME@localhost:5432/ttbs_newsfeed

# Redis is shared with other apps on this host: dedicated DB numbers, never FLUSHDB.
BROKER_URL=redis://localhost:6379/5
REDIS_CACHE_URL=redis://localhost:6379/6

# Research provider: "perplexity" (real API, costs money) or "fake" (offline).
# The Perplexity API key and model are NOT set here: enter them in the UI under
# Providers & channels. They are stored encrypted in the database with SECRETS_KEY.
LLM_PROVIDER=perplexity
# 32 random bytes, url-safe base64. Generate with:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SECRETS_KEY=
LLM_RATE_PER_SECOND=45
RESEARCH_WINDOW_DAYS=10
RESEARCH_MAX_RETRIES=5

# Notifications go to the console adapter (logged, not sent) in this phase.
NOTIFY_EMAIL_ADAPTER=console
NOTIFY_WHATSAPP_ADAPTER=console
NOTIFY_MAX_ATTEMPTS=6

DISPATCHER_INTERVAL_S=30
STUCK_AFTER_MINUTES=20
