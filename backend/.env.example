# Copy to backend/.env and fill in. Never commit .env.
ENV=dev
LOG_LEVEL=INFO

# MySQL: mysql+pymysql://ttbs:CHANGE_ME@localhost:3306/ttbs_newsfeed?charset=utf8mb4
# Postgres: postgresql+psycopg://ttbs:CHANGE_ME@localhost:5432/ttbs_newsfeed
DATABASE_URL=mysql+pymysql://ttbs:CHANGE_ME@localhost:3306/ttbs_newsfeed?charset=utf8mb4

# Redis is shared with other apps on this host: dedicated DB numbers, never FLUSHDB.
BROKER_URL=redis://localhost:6379/5
REDIS_CACHE_URL=redis://localhost:6379/6

# Research provider: "perplexity" (real API, costs money) or "fake" (offline).
# The Perplexity API key and model are NOT set here: enter them in the UI under
# Providers & channels. They are stored encrypted in the database with SECRETS_KEY.
LLM_PROVIDER=perplexity
# 32 random bytes, url-safe base64. Generate with:
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SECRETS_KEY=
LLM_RATE_PER_SECOND=45
RESEARCH_WINDOW_DAYS=10
RESEARCH_MAX_RETRIES=5

# Notifications go to the console adapter (logged, not sent) in this phase.
NOTIFY_EMAIL_ADAPTER=console
NOTIFY_WHATSAPP_ADAPTER=console
# Email: Microsoft Graph credentials, sending limits, retry policy and templates are set in the UI
# (Providers & channels, Output templates). Until a mailbox is connected, NOTIFY_EMAIL_ADAPTER applies.
EMAIL_DISPATCH_INTERVAL_S=10
NOTIFY_MAX_ATTEMPTS=6

DISPATCHER_INTERVAL_S=30
STUCK_AFTER_MINUTES=20

# FinOps (USD). New runs are refused once month-to-date spend reaches the budget (hard cap).
MONTHLY_BUDGET_USD=500
BUDGET_SOFT_LIMIT_PCT=80
BUDGET_HARD_CAP=true
# Per-message delivery prices for the cost ledger: take them from your Meta / mail rate cards.
NOTIFY_PRICE_WHATSAPP_USD=0
NOTIFY_PRICE_EMAIL_USD=0

# Telemetry. Every pipeline step is stored in process_events (run timeline, Telemetry page).
# Prometheus: the API serves /metrics; each worker serves its own on this port (0 = off).
METRICS_WORKER_PORT=9464
# OpenTelemetry traces: set to an OTLP/HTTP collector (e.g. http://localhost:4318) to export; empty = off.
OTEL_EXPORTER_OTLP_ENDPOINT=
