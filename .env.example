# Settings for one environment. Copy to .env.dev, .env.uat or .env.prod (never commit them),
# fill every CHANGE_ME and empty secret, then: chmod 600 .env.<stage> && ./deploy.sh <stage> up
# Lines marked [dev/uat] or [prod] apply only there.

# dev: ENV=dev (API docs on /docs).  uat, prod: ENV=prod (production settings, no docs).
ENV=dev
LOG_LEVEL=INFO

# --- Database ---
# [dev/uat] MySQL container, created on first start. DATABASE_URL must match these values.
MYSQL_ROOT_PASSWORD=CHANGE_ME_root
MYSQL_DATABASE=ttbs_newsfeed
MYSQL_USER=ttbs
MYSQL_PASSWORD=CHANGE_ME_ttbs
DATABASE_URL=mysql+pymysql://ttbs:CHANGE_ME_ttbs@mysql:3306/ttbs_newsfeed?charset=utf8mb4
# [prod] Delete the MYSQL_* lines and point at the external MySQL 8.4 server (database and user
# must exist). MySQL on the same host: use host.docker.internal, not localhost.
#   DATABASE_URL=mysql+pymysql://ttbs:CHANGE_ME@db.example.internal:3306/ttbs_newsfeed?charset=utf8mb4
# Avoid @ : / ? # % in passwords (or URL-encode them).

# --- Redis (container on the internal network). Letters and digits only: it goes into URLs. ---
REDIS_PASSWORD=CHANGE_ME_redis
BROKER_URL=redis://:CHANGE_ME_redis@redis:6379/5
REDIS_CACHE_URL=redis://:CHANGE_ME_redis@redis:6379/6

# --- Required: 32 random bytes, url-safe base64, different per environment. Encrypts the LLM
# API keys stored in the DB: back it up (losing it makes saved keys unreadable).
#   python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SECRETS_KEY=

# "perplexity" = live API (key set in the UI); "fake" = offline, no key or cost.
LLM_PROVIDER=perplexity
NOTIFY_EMAIL_ADAPTER=console
NOTIFY_WHATSAPP_ADAPTER=console
# Email: Microsoft Graph credentials, sending limits, retry policy and templates are set in the UI
# (Providers & channels, Output templates). Until a mailbox is connected, NOTIFY_EMAIL_ADAPTER applies.
EMAIL_DISPATCH_INTERVAL_S=10
MONTHLY_BUDGET_USD=50
# BUDGET_SOFT_LIMIT_PCT=80
# BUDGET_HARD_CAP=true

# --- Sign-in & sessions (docs/security.md) ---
# First admin: created at startup only while no user exists, and forced to change this password
# at first sign-in. Must meet the policy (12+ chars, upper, lower, digit, symbol, no common words,
# not the username). Delete this value once the admin has signed in.
ADMIN_USERNAME=admin
ADMIN_NAME=Administrator
ADMIN_INITIAL_PASSWORD=
# The cookie is Secure: HTTPS only (browsers also accept it on http://localhost / 127.0.0.1).
SESSION_COOKIE_SECURE=true
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12
PASSWORD_HISTORY_COUNT=5
PASSWORD_MAX_AGE_DAYS=90
# The SPA and API share one origin behind the gateway: no cross-origin access.
CORS_ORIGINS=[]

# --- Gateway (only these reach the internet-facing container) ---
# [dev/uat] Password gate in front of /phpmyadmin/: one "user:bcrypt-hash" line. Generate:
#   printf '%s' 'YOUR-STRONG-PASSWORD' | podman run --rm -i docker.io/library/phpmyadmin:5.2.3 htpasswd -niB -C 12 dbadmin
# Keep the single quotes (the hash contains $). Empty = the gate refuses everyone.
GATEWAY_PMA_HTPASSWD=''
# [prod] Where the gateway listens (dev/uat are always 127.0.0.1:5173 / :5175).
# GATEWAY_BIND=0.0.0.0
# GATEWAY_PORT=80
