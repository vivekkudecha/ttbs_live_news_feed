# PROD environment - used by docker-compose.prod.yml (copy to .env.prod; never commit .env.prod).
ENV=prod
LOG_LEVEL=INFO

# --- External database (MySQL 8.4 LTS recommended (8.0 is end-of-life); the database and user must already exist) ---
# Use the DB server's hostname/IP. If MySQL runs on this same host, use host.docker.internal
# (not localhost) and make sure MySQL listens on an address the containers can reach.
# Avoid @ : / ? # % in the password (or URL-encode them).
DATABASE_URL=mysql+pymysql://ttbs:CHANGE_ME@db.example.internal:3306/ttbs_newsfeed?charset=utf8mb4

# --- Redis container (bundled) ---
# Redis requires this password (letters and digits only, so it is URL-safe below).
REDIS_PASSWORD=CHANGE_ME_redis
BROKER_URL=redis://:CHANGE_ME_redis@redis:6379/5
REDIS_CACHE_URL=redis://:CHANGE_ME_redis@redis:6379/6

# --- Required: 32 random bytes, url-safe base64. Back it up: losing it makes saved API keys unreadable. ---
# python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SECRETS_KEY=

LLM_PROVIDER=perplexity

NOTIFY_EMAIL_ADAPTER=console
NOTIFY_WHATSAPP_ADAPTER=console
MONTHLY_BUDGET_USD=500
BUDGET_SOFT_LIMIT_PCT=80
BUDGET_HARD_CAP=true

# --- Sign-in & sessions (docs/security.md) ---
# First admin: created at startup only while no user exists, and forced to change this password
# at first sign-in. It must meet the policy (12+ chars, upper, lower, digit, symbol, no common
# words, no username). Remove it from this file once the admin has signed in.
ADMIN_USERNAME=admin
ADMIN_NAME=Administrator
ADMIN_INITIAL_PASSWORD=
# Session cookie is Secure: prod MUST be served over HTTPS (TLS in front of the gateway).
SESSION_COOKIE_SECURE=true
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
PASSWORD_MIN_LENGTH=12
PASSWORD_HISTORY_COUNT=5
PASSWORD_MAX_AGE_DAYS=90
# SPA and API share one origin behind the gateway: no cross-origin access is needed.
CORS_ORIGINS=[]
