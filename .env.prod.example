# PROD environment - used by docker-compose.prod.yml (copy to .env.prod; never commit .env.prod).
ENV=prod
LOG_LEVEL=INFO

# --- External database (MySQL 8.0.13+; the database and user must already exist) ---
# Use the DB server's hostname/IP. If MySQL runs on this same host, use host.docker.internal
# (not localhost) and make sure MySQL listens on an address the containers can reach.
# Avoid @ : / ? # % in the password (or URL-encode them).
DATABASE_URL=mysql+pymysql://ttbs:CHANGE_ME@db.example.internal:3306/ttbs_newsfeed?charset=utf8mb4

# --- Redis container (bundled) ---
BROKER_URL=redis://redis:6379/5
REDIS_CACHE_URL=redis://redis:6379/6

# --- Required: 32 random bytes, url-safe base64. Back it up: losing it makes saved API keys unreadable. ---
# python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SECRETS_KEY=

LLM_PROVIDER=perplexity

NOTIFY_EMAIL_ADAPTER=console
NOTIFY_WHATSAPP_ADAPTER=console
MONTHLY_BUDGET_USD=500
BUDGET_SOFT_LIMIT_PCT=80
BUDGET_HARD_CAP=true
