.git/
.gitignore
.env
**/.env
node_modules/
backend/.venv/
backend/__pycache__/
backend/*.db*
backend/.pytest_cache/
backend/.ruff_cache/
backend/storage/uploads/*
frontend/node_modules/
frontend/dist/
frontend/dist-artifact/

# Secrets never enter a build context
.env.*
!.env.example
# Not needed by any image built from the repo root (the gateway)
backend/
docs/
.gitnexus/
